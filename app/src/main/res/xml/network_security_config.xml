<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS нужен для DeepSeek/GitHub. Cleartext оставлен только для будущего
  app-private loopback runtime и локальной отладки; пользовательские CA
  поддерживают самоподписанные сертификаты в инженерной среде.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
