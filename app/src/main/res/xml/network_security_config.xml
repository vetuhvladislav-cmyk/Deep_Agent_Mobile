<?xml version="1.0" encoding="utf-8"?>
<!--
  Внешние provider endpoints работают только по HTTPS. Если будущий
  app-private loopback backend потребует cleartext, его нужно разрешить
  отдельным узким domain-config после подтверждения backend ABI.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
